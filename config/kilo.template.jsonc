// ai-standards — configurazione centrale Kilo Code
// NON modificare il file generato in ~/.config/ai-standards/kilo.jsonc:
// modifica questo template nel repo e rilancia l'installazione.
//
// Dalla v0.2.0 gli standard sono "opt-in": regole e permessi vivono
// nell'agente agents/aziendale.md. Qui restano solo:
//  - i server MCP (collegati, ma con i tool vietati fuori dall'agente aziendale)
//  - il divieto delle skill aziendali per tutti gli altri agenti
{
  "$schema": "https://app.kilo.ai/config.json",

  // Server MCP aziendali. Stessi server del plugin Copilot (mcp.json e
  // copilot-plugins/oracle-sqlcl/mcp.json): se ne cambi uno, cambia anche l'altro.
  // Prerequisiti sul PC: Node.js (per npx); per sqlcl, SQLcl con la cartella bin nel PATH.
  "mcp": {
    "azure-devops": {
      "type": "local",
      // -d: domini abilitati (core, work, work-items, search, test-plans,
      //     repositories, wiki, pipelines, advanced-security).
      // Consigliato: fissare la versione (es. @azure-devops/mcp@2.3.0) invece di @latest.
      "command": ["npx", "-y", "@azure-devops/mcp@latest", "AlmaHealth",
                  "-d", "core", "work", "work-items", "repositories", "pipelines", "wiki", "search"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "sqlcl": {
      // Accesso ai database: spento di default. Si accende per progetto con
      // .kilo/kilo.jsonc -> { "mcp": { "sqlcl": { "enabled": true } } }
      "type": "local",
      "command": ["sql", "-mcp"],
      "enabled": false,
      "timeout": 30000
    }
  },

  // Permessi GLOBALI: valgono per tutti gli agenti (Code, Plan, Debug...).
  // L'agente Aziendale li sovrascrive con i propri (vedi agents/aziendale.md).
  // Ordine: pattern generici prima, specifici dopo.
  "permission": {
    "skill": {
      "*": "allow",
      "be-spring-microservice": "deny",
      "fe-angular-sae": "deny",
      "api-contract-openapi": "deny",
      "testing-standards": "deny"
    },
    "azure-devops_*": "deny",
    "playwright_*": "deny",
    "sqlcl_*": "deny"
  }
}
